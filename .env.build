# .env.build — dummy values for build-time env validation only
# Real values are injected at runtime via docker compose env_file
NEXT_PUBLIC_APP_URL=https://modawim.com
NEXT_PUBLIC_FIREBASE_API_KEY=dummy
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dummy.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dummy
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dummy.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:dummy
NEXT_PUBLIC_FIREBASE_VAPID_KEY=dummy
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID=dummy
NEXT_PUBLIC_SENTRY_DSN=

# Same origin as production `R2_PUBLIC_BASE_URL` — required for `next/image` remotePatterns during `pnpm build`
# (Docker builder). CI can override via the step after this file is appended to.
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.modawim.com

BETTER_AUTH_SECRET=dummy_secret_at_least_32_characters_long
BETTER_AUTH_URL=https://modawim.com
DATABASE_URL=postgresql://dummy:dummy@localhost:5432/dummy
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
GITHUB_CLIENT_ID=dummy
GITHUB_CLIENT_SECRET=dummy
GMAIL_FROM_EMAIL=dummy@dummy.com
GMAIL_FROM_NAME=dummy
GMAIL_USER=dummy@dummy.com
GMAIL_APP_PASSWORD=dummy
CLOUDINARY_CLOUD_NAME=dummy
CLOUDINARY_API_KEY=dummy
CLOUDINARY_API_SECRET=dummy
CLOUDINARY_ROOT_FOLDER=dummy
FIREBASE_PROJECT_ID=dummy
FIREBASE_CLIENT_EMAIL=dummy@dummy.iam.gserviceaccount.com
