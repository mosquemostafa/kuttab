{
  "name": "almostafa",
  "version": "1.0.0",
  "description": "Almostafa — Islamic institute for teaching the Holy Quran with Next.js 16, Better Auth, PostgreSQL, Drizzle ORM, multi-language RTL support, and Admin Portal.",
  "private": true,
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "author": "Abdelrahman Nassar",
  "license": "UNLICENSED",
  "homepage": "https://modawim.com",
  "scripts": {
    "dev": "next dev --turbopack",
    "worker:dev": "tsx src/server/workers/run-worker.ts",
    "swagger:generate": "tsx scripts/generate-swagger.ts",
    "build:worker": "esbuild src/server/workers/run-worker.ts --bundle --platform=node --target=node22 --outfile=dist/worker.js --external:pg-native",
    "prebuild": "pnpm run swagger:generate",
    "build": "pnpm run swagger:generate && next build --webpack && pnpm run build:worker",
    "start": "node .next/standalone/server.js",
    "start:local": "mkdir -p .next/standalone/.next && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && node .next/standalone/server.js",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:smoke:headed": "playwright test --grep @smoke --project=chromium --headed",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-cli.mjs migrate",
    "db:migrate:local": "node scripts/db-cli.mjs migrate local",
    "db:migrate:test": "node scripts/db-cli.mjs migrate test",
    "db:migrate:prod": "node scripts/db-cli.mjs migrate prod",
    "db:push": "node scripts/db-cli.mjs push",
    "db:push:local": "node scripts/db-cli.mjs push local",
    "db:push:test": "node scripts/db-cli.mjs push test",
    "db:studio": "node scripts/db-cli.mjs studio",
    "db:studio:local": "node scripts/db-cli.mjs studio local",
    "db:studio:test": "node scripts/db-cli.mjs studio test",
    "db:studio:prod": "node scripts/db-cli.mjs studio prod",
    "db:squash": "node scripts/db-squash.mjs",
    "db:seed": "node scripts/db-cli.mjs seed local",
    "db:seed:local": "node scripts/db-cli.mjs seed local",
    "db:reset:local": "node scripts/db-cli.mjs reset local",
    "db:reset:test": "node scripts/db-cli.mjs reset test",
    "db:baseline:mark:local": "node scripts/db-cli.mjs baseline local",
    "db:baseline:mark:test": "node scripts/db-cli.mjs baseline test",
    "db:baseline:mark:prod": "node scripts/db-cli.mjs baseline prod",
    "db:verify": "node scripts/db-cli.mjs verify",
    "db:verify:local": "node scripts/db-cli.mjs verify local",
    "db:verify:test": "node scripts/db-cli.mjs verify test",
    "db:verify:prod": "node scripts/db-cli.mjs verify prod",
    "dock": "docker compose up -d",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check:deps": "pnpm exec knip",
    "check:i18n": "node scripts/check-i18n-translator-aliases.mjs",
    "check:guidelines": "node scripts/check-guidelines.mjs",
    "format": "pnpm exec prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@base-ui/react": "^1.9.0",
