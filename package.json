    "js-confetti": "^0.13.1",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^0.562.0",
    "marked": "^18.0.3",
    "next": "^16.4.3",
    "next-intl": "^4.8.3",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^8.0.4",
