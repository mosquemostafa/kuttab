    "webpack": "^5.106.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  },
  "overrides": {
    "esbuild": "^0.25.12"
  },
  "browserslist": [
    "chrome >= 120",
    "safari >= 17",
    "firefox >= 120",
    "edge >= 120"
  ]
